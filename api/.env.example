# Copy to .env and change SECRET_KEY. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://building_entry:building_entry@localhost:5432/building_entry
TEST_DATABASE_URL=postgresql+psycopg://building_entry:building_entry@localhost:5432/building_entry_test

# Signs the session cookie. Anyone who knows it can sign in as any user. At least 32 characters.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME

# Set to true when the app is served over HTTPS (hosted demo).
COOKIE_SECURE=false

# First Platform Admin, created by `uv run alembic upgrade head` (migration 0002).
# If the email already has an account, it's promoted and keeps its password.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME
PLATFORM_ADMIN_NAME=Platform Admin
